# Copie para .env.local (desenvolvimento). No servidor, configure no hPanel.
# NUNCA commite valores reais. Todas são usadas somente no servidor.

# Token pessoal do ClickUp: Configurações > Apps > Token de API (começa com pk_)
CLICKUP_TOKEN=
# ID da lista "CONTROLE DE VERBA" (número na URL da lista)
CLICKUP_LIST_ID=
# Nome EXATO do campo personalizado (tipo Número ou Moeda). Padrão se vazio: Verba Atual 2.0
CLICKUP_CAMPO_VERBA=Verba Atual 2.0
# Senha única de acesso ao sistema. Use uma senha longa.
APP_PASSWORD=
# Nome EXATO do campo de lista suspensa com a forma de pagamento (somente leitura). Padrão se vazio: Tipo de pagamento
CLICKUP_CAMPO_PAGAMENTO=Tipo de pagamento
